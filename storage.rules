rules_version = '2';

// Inspirata / Krystine Main — Firebase Storage security rules.
// Public read for uploaded site imagery, admin-only write.

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'admin@krystinestlaurent.ca',
          'krystine@inspiratanature.com',
          'alex@lesalondesinconnus.com',
          'krystinestlaurent@gmail.com',
          'houseoftherisingarts@gmail.com',
          'krystinestterredhysope@gmail.com'
        ];
    }

    // Le contenu des formations est privé : l'écriture reste à l'admin et la
    // lecture passe par la fonction obtenirLecon (URL signée après achat).
    // Les règles Storage s'additionnent par OU : le tout-venant ci-dessous
    // capture donc le premier segment pour EXCLURE formations-contenu.
    // Le terrain d'essai du Foyer, où Krystine s'entraîne à déposer ses leçons.
    // Écriture réservée à l'administration, comme partout, mais lecture fermée
    // elle aussi : une vraie leçon déposée pendant un essai ne doit pas se
    // retrouver ouverte à qui devine l'adresse du fichier. Le tout-venant plus
    // bas laisserait la lecture publique, alors la règle est nommée ici, et les
    // règles de Storage s'additionnent par OU. Une leçon est un module Kajabi :
    // plusieurs pièces par leçon, vidéo, audio, PDF ou image (Alex, 10 sept 2026).
    match /foyer-essai/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin()
                   && request.resource.size < 2 * 1024 * 1024 * 1024   // 2 Go par pièce
                   && request.resource.contentType.matches('(video|audio|image)/.*|application/pdf');
    }

    match /formations-contenu/{allPaths=**} {
      allow write: if isAdmin()
                   && request.resource.size < 2 * 1024 * 1024 * 1024;  // 2 GB par leçon
    }

    // Le mur : chaque membre téléverse ses photos et vidéos dans son propre
    // dossier, image ou vidéo seulement, 200 Mo au plus.
    match /mur/{uid}/{fichier} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 200 * 1024 * 1024
                   && request.resource.contentType.matches('(image|video)/.*');
    }

    // Les captures d'écran des problèmes techniques : chaque membre écrit
    // dans son dossier, image seulement, 10 Mo au plus; Krystine lit tout.
    // La bannière personnelle de l'espace client : chaque membre dépose la
    // sienne. Avant le 11 septembre 2026, le dossier tombait dans la règle
    // générale réservée à l'admin et toute cliente échouait en silence
    // (rapport de Caroline Jetté, 8 septembre).
    match /bannieres/{uid}/{fichier} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 15 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /bugs/{uid}/{fichier} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Le paquet Obsidian de Krystine (notes du vault d'Alex, zip publié par
    // krystine_vault_publier) : lecture par l'admin ou par le relais Iris.
    match /vault/{fichier} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email == 'iris@krystinestlaurent.ca');
      allow write: if false;
    }

    // La pièce d'identité du Badge Bleu : la membre dépose (et peut retirer)
    // `piece.<ext>` dans son propre dossier, image ou PDF, 8 Mo au plus.
    // L'admin seul la lit, par son chemin exact : personne ne liste le dossier.
    // Le serveur la supprime à la décision (functions/src/verification.ts).
    match /verifications/{uid}/{fichier} {
      allow get: if isAdmin();
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                   && fichier.matches('piece\\.(jpg|png|webp|heic|pdf)')
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|png|webp|heic)|application/pdf');
    }

    match /{dossier}/{allPaths=**} {
      allow read: if dossier != 'formations-contenu' && dossier != 'vault' && dossier != 'verifications' && dossier != 'foyer-essai';
      allow write: if isAdmin()
                   && request.resource.size < 500 * 1024 * 1024  // 500 MB
                   && request.resource.contentType.matches('(image|video|audio)/.*|application/pdf');
    }
    match /{fichier} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 500 * 1024 * 1024
                   && request.resource.contentType.matches('(image|video|audio)/.*|application/pdf');
    }
  }
}
