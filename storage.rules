rules_version = '2';

// Inspirata / Krystine Main — Firebase Storage security rules.
// Public read for uploaded site imagery, admin-only write.

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'admin@krystinestlaurent.ca',
          'krystine@inspiratanature.com',
          'houseoftherisingarts@gmail.com'
        ];
    }

    // Le contenu des formations est privé : l'écriture reste à l'admin et la
    // lecture passe par la fonction obtenirLecon (URL signée après achat).
    // Les règles Storage s'additionnent par OU : le tout-venant ci-dessous
    // capture donc le premier segment pour EXCLURE formations-contenu.
    match /formations-contenu/{allPaths=**} {
      allow write: if isAdmin()
                   && request.resource.size < 2 * 1024 * 1024 * 1024;  // 2 GB par leçon
    }

    match /{dossier}/{allPaths=**} {
      allow read: if dossier != 'formations-contenu';
      allow write: if isAdmin()
                   && request.resource.size < 500 * 1024 * 1024  // 500 MB
                   && request.resource.contentType.matches('(image|video|audio)/.*|application/pdf');
    }
    match /{fichier} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 500 * 1024 * 1024
                   && request.resource.contentType.matches('(image|video|audio)/.*|application/pdf');
    }
  }
}
