// Jamais d'image générée sur la boutique (8 oct. 2026) : toute photo Shopify dont
// le nom trahit l'IA est écartée, et la vignette prend la première photo réelle.
const estIA = (u?: string | null) => !!u && /gemini|dall|midjourney|firefly|generated/i.test(u);
function sansIA<T extends ShopifyProduct>(p: T): T {
  const images = p.images.filter(i => !estIA(i.url));
  const choisie = photoProduit(p);
  const featuredImage = choisie ? ([p.featuredImage, ...p.images].find(i => i?.url === choisie) || null) : null;
  return { ...p, images, featuredImage };
}

