/* Le fondu de la carte vedette : vert profond adouci vers crème lumineuse,
 * lissé comme le voile des cartes de presse (6t⁵ − 15t⁴ + 10t³, aucune arête),
 * mélangé en oklab pour ne jamais passer par un gris ou un brun terne. */
const lisse = (x: number) => x * x * x * (x * (x * 6 - 15) + 10);
function fonduCarte(sens: 'to left' | 'to bottom'): string {
  // sens « to left » : la crème est à droite (0 %), le vert à gauche (100 %).
  // « to bottom » : la crème en haut (0 %), le vert en bas.
  const debut = sens === 'to left' ? 0.18 : 0.14;  // crème pleine jusque-là
  const fin = sens === 'to left' ? 0.6 : 0.3;      // vert plein dès là
  const creme = [238, 231, 219], vert = [47, 63, 55];
  const arrets: string[] = [];
  for (let i = 0; i <= 20; i += 1) {
    const t = i / 20;
    const k = t <= debut ? 0 : t >= fin ? 1 : lisse((t - debut) / (fin - debut));
    const c = creme.map((v, j) => Math.round(v + (vert[j] - v) * k));
    arrets.push(`rgb(${c.join(',')}) ${(t * 100).toFixed(1)}%`);
  }
  const dir = sens === 'to left' ? 'to left' : 'to bottom';
  return `linear-gradient(in oklab ${dir}, ${arrets.join(', ')})`;
}

