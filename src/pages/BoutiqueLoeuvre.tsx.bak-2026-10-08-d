/* ── Un bienfait à la fois (8 oct. 2026, « un texte qui s'écrit ») ──
 * Chaque lettre apparaît en fondu (rythme du site, cubic-bezier(.16,.8,.24,1)),
 * la ligne reste, s'efface doucement, puis la suivante s'écrit, en boucle.
 * Ne tourne que lorsque la section est à l'écran. Lecteurs d'écran : la liste
 * complète en texte; l'animation est aria-hidden. Mouvement réduit : liste fixe. */
const BIENFAITS_FR = [
  // Fragments mot pour mot de Nature & Ayurveda (Krystine St-Laurent, 2018), choisis par Krystine.
  'apaiser vata',
  'apaiser la tête',
  'apaiser le cœur, les émotions',
  'apaiser le corps en entier',
  'le système circulatoire',
  'le système lymphatique',
  'le système nerveux',
  'au même titre que se nourrir, dormir, bouger',
];

const MachineAEcrire: React.FC<{ lignes: string[] }> = ({ lignes }) => {
  const reduce = useReducedMotion();
  const hote = React.useRef<HTMLDivElement>(null);
  const [visible, setVisible] = useState(false);
  const [i, setI] = useState(0);
  const [n, setN] = useState(0);
  const [efface, setEfface] = useState(false);

  useEffect(() => {
    const el = hote.current;
    if (!el) return;
    const io = new IntersectionObserver(([e]) => setVisible(e.isIntersecting), { threshold: 0.3 });
    io.observe(el);
    return () => io.disconnect();
  }, []);

  useEffect(() => {
    if (reduce || !visible) return;
    const ligne = lignes[i];
    let t: number;
    if (efface) {
      t = window.setTimeout(() => { setEfface(false); setN(0); setI(k => (k + 1) % lignes.length); }, 900);
    } else if (n < ligne.length) {
      // un peu plus lent après la ponctuation, pour respirer
      const pause = /[,.:;]/.test(ligne[n - 1] || '') ? 260 : 70;
      t = window.setTimeout(() => setN(k => k + 1), pause);
    } else {
      t = window.setTimeout(() => setEfface(true), 2400);
    }
    return () => window.clearTimeout(t);
  }, [reduce, visible, i, n, efface, lignes]);

  if (reduce) {
    return (
      <ul className="flex flex-wrap gap-x-2 gap-y-1 v2-serif font-light text-[1.0625rem] leading-[1.55] text-[#1c1712]">
        {lignes.map((l, k) => <li key={l}>{l}{k < lignes.length - 1 ? ' ·' : ''}</li>)}
      </ul>
    );
  }

  const ligne = lignes[i];
  return (
    <div ref={hote}>
      <ul className="sr-only">{lignes.map(l => <li key={l}>{l}</li>)}</ul>
      <p
        aria-hidden
        className="min-h-[1.6em] v2-serif font-light text-[clamp(1.1rem,1.4vw,1.25rem)] leading-[1.6] text-[#1c1712] transition-[opacity,filter] duration-[900ms] ease-[cubic-bezier(.16,.8,.24,1)]"
        style={{ opacity: efface ? 0 : 1, filter: efface ? 'blur(3px)' : 'blur(0px)' }}
      >
        {Array.from(ligne).flatMap((c, k) => {
          const lettre = <span key={`${i}-${k}`} className="transition-opacity duration-[420ms] ease-[cubic-bezier(.16,.8,.24,1)]" style={{ opacity: k < n ? 1 : 0 }}>{c}</span>;
          return k === n ? [<span key="curseur" className="ml-[1px] inline-block h-[1.05em] w-[1.5px] translate-y-[0.18em] bg-[#BA7B39] animate-[curseur_1.1s_cubic-bezier(.16,.8,.24,1)_infinite]" />, lettre] : [lettre];
        })}
        {n >= ligne.length && <span className="ml-[1px] inline-block h-[1.05em] w-[1.5px] translate-y-[0.18em] bg-[#BA7B39] animate-[curseur_1.1s_cubic-bezier(.16,.8,.24,1)_infinite]" />}
      </p>
    </div>
  );
};

