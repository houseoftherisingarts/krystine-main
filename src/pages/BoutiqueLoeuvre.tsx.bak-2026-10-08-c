const EASE = [0.22, 1, 0.36, 1] as const;
// La révélation du canon (7 oct. 2026) : lente, 1,1 s, sans rebond, flou 6 px vers net.
const EASE_REVEAL = [0.16, 0.8, 0.24, 1] as const;

type ShopifyVariant = ShopifyProduct['variants'][number];

// Jamais d'image générée sur la boutique (8 oct. 2026) : toute photo Shopify dont
// le nom trahit l'IA est écartée, et la vignette prend la première photo réelle.
const estIA = (u?: string | null) => !!u && /gemini|dall|midjourney|firefly|generated/i.test(u);
function sansIA<T extends ShopifyProduct>(p: T): T {
  const images = p.images.filter(i => !estIA(i.url));
  const featuredImage = p.featuredImage && !estIA(p.featuredImage.url) ? p.featuredImage : images[0] || null;
  return { ...p, images, featuredImage };
}

// Les deux soins que la famille Visage montre toujours (Krystine, 8 oct. 2026).
const VISAGE_TOUJOURS = ['serum-visage-defripant', 'huile-nasale-nez-zen'];

