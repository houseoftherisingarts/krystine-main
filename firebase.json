{
  "hosting": {
    "predeploy": [
      "node scripts/garde-collant.mjs --dist"
    ],
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/accueil",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/api/vh",
        "function": {
          "functionId": "vhCollecter",
          "region": "us-central1"
        }
      },
      {
        "source": "/accueil",
        "destination": "/accueil/index.html"
      },
      {
        "source": "/accueil/**",
        "destination": "/accueil/index.html"
      },
      {
        "source": "/communaute",
        "destination": "/communaute/index.html"
      },
      {
        "source": "/communaute/**",
        "destination": "/communaute/index.html"
      },
      {
        "source": "/speaking",
        "destination": "/speaking/index.html"
      },
      {
        "source": "/speaking/**",
        "destination": "/speaking/index.html"
      },
      {
        "source": "/liste-attente-origine",
        "destination": "/liste-attente-origine/index.html"
      },
      {
        "source": "/liste-attente-origine/**",
        "destination": "/liste-attente-origine/index.html"
      },
      {
        "source": "/krystine",
        "destination": "/og/krystine.html"
      },
      {
        "source": "/conferenciere",
        "destination": "/og/conferenciere.html"
      },
      {
        "source": "/formations",
        "destination": "/og/formations.html"
      },
      {
        "source": "/medias",
        "destination": "/og/medias.html"
      },
      {
        "source": "/5elements",
        "destination": "/og/5elements.html"
      },
      {
        "source": "/medias/tv",
        "destination": "/og/medias-tv.html"
      },
      {
        "source": "/podcast",
        "destination": "/og/podcast.html"
      },
      {
        "source": "/podcast/question",
        "destination": "/og/podcast-question.html"
      },
      {
        "source": "/boutique",
        "destination": "/og/boutique.html"
      },
      {
        "source": "/blogue",
        "destination": "/og/blogue.html"
      },
      {
        "source": "/points-de-vente",
        "destination": "/og/points-de-vente.html"
      },
      {
        "source": "/quiz",
        "destination": "/og/quiz.html"
      },
      {
        "source": "/guide",
        "destination": "/og/guide.html"
      },
      {
        "source": "/origine",
        "destination": "/og/origine.html"
      },
      {
        "source": "/vata",
        "destination": "/og/vata.html"
      },
      {
        "source": "/origine-2",
        "destination": "/og/origine-2.html"
      },
      {
        "source": "/liste-attente",
        "destination": "/og/liste-attente.html"
      },
      {
        "source": "/compte",
        "destination": "/og/compte.html"
      },
      {
        "source": "/politique-de-confidentialite",
        "destination": "/og/politique-de-confidentialite.html"
      },
      {
        "source": "/presse",
        "destination": "/og/presse.html"
      },
      {
        "source": "/presskit",
        "destination": "/og/presse.html"
      },
      {
        "source": "/press-kit",
        "destination": "/og/presse.html"
      },
      {
        "source": "/en/press",
        "destination": "/og/presse.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|jsx|ts|tsx|css|json)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=31536000"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|svg|avif)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=604800"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self' https://vexelwebstudio.com https://www.vexelwebstudio.com https://vexel-webstudio.web.app"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "**/*.@(mp4|webm|glb)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "max-age=604800"
          }
        ]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "runtime": "nodejs22"
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "auth": {
      "port": 9099
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": false
    }
  }
}
