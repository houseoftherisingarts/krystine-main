rules_version = '2';

// Inspirata / Krystine Main — Firestore security rules.
//
// Public site pages read events / blog posts / media library / settings.
// Public forms (newsletter, dosha quiz, booking requests) allow create-only from anyone.
// Signed-in members own their own profile, orders, and support conversation.
// All admin operations are gated on the ADMIN allowlist in the auth token.

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in [
          'admin@krystinestlaurent.ca',
          'krystine@inspiratanature.com',
          'alex@lesalondesinconnus.com',
          'krystinestterredhysope@gmail.com',
          'krystinestlaurent@gmail.com',
          'houseoftherisingarts@gmail.com'
        ];
    }
    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }

    // ── Public read, admin write ──
    match /events/{id}        { allow read: if true; allow write: if isAdmin(); }
    // Directs du podcast : la page publique lit la date et le lien; l'admin écrit.
    match /liveEvents/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /blogPosts/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /mediaLibrary/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /formations/{id}    { allow read: if true; allow write: if isAdmin(); }
    // Le plan des leçons est lisible (titres et durées pour la fiche du cours);
    // le FICHIER passe par la fonction obtenirLecon qui vérifie l'achat.
    match /formations/{id}/lecons/{lid} { allow read: if true; allow write: if isAdmin(); }
    // La progression appartient à la personne (cases cochées, dernière leçon).
    match /progression/{uid}/formations/{fid} {
      allow read, write: if isSelf(uid) || isAdmin();
    }

    // ── Le mur social (porté du FMM) ─────────────────────────────────────
    // Les compteurs (pour/contre/score/chaleur/nbCommentaires) ne s'écrivent
    // JAMAIS depuis le navigateur : les fonctions mur.ts recomptent avec
    // l'Admin SDK, qui contourne ces règles.
    match /mur/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.texte is string
                    && request.resource.data.texte.size() <= 5000
                    && (request.resource.data.fil == 'communaute' || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      match /votes/{voterUid} {
        allow read: if isSignedIn();
        allow write: if isSelf(voterUid);
      }
      match /commentaires/{cid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.texte is string
                      && request.resource.data.texte.size() <= 2000;
        allow update: if false;
        allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

        match /votes/{voterUid} {
          allow read: if isSignedIn();
          allow write: if isSelf(voterUid);
        }
      }
    }

    match /blocages/{uid} { allow read, write: if isSelf(uid); }

    // ── Messagerie privée et amitiés (portées du FMM) ────────────────────
    match /dms/{filId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantUids;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participantUids;
      allow delete: if false;

      match /messages/{mid} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/dms/$(filId)).data.participantUids;
        allow create: if isSignedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/dms/$(filId)).data.participantUids;
        allow update, delete: if false;
      }
    }

    match /amities/{id} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.paire;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.paire;
      allow update, delete: if isSignedIn() && request.auth.uid in resource.data.paire;
    }

    // ── Badges (moteur du FMM) : chacun lit tout, n'écrit que sa vitrine.
    // Les badges se posent côté serveur (fonctions badges.ts, Admin SDK).
    match /badges/{uid} {
      allow read: if isSignedIn();
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['exposes'])
        && request.resource.data.exposes is list
        && request.resource.data.exposes.size() <= 5;
      allow create, delete: if false;
    }
    // ── Parrainage : le code est public en lecture (résolution du lien);
    // chacun crée le sien; la filiation s'écrit une fois par la filleule.
    // Le compteur et les badges viennent du serveur (parrainage.ts).
    match /codesParrain/{code} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /parrainages/{filleulUid} {
      allow read: if isSelf(filleulUid) || isAdmin();
      allow create: if isSelf(filleulUid)
                    && request.resource.data.parrainUid is string
                    && request.resource.data.parrainUid != request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /signalements/{id} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }
    // La preuve d'achat d'une formation : le membre lit la sienne; l'écriture
    // vient du serveur (webhook Stripe) ou de l'admin (tests, cadeaux).
    match /achatsFormations/{uid}/formations/{fid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isAdmin();
    }
    match /settings/{id}      { allow read: if true; allow write: if isAdmin(); }
    match /siteOverrides/{id} { allow read: if true; allow write: if isAdmin(); }

    // ── Écoutes du podcast sur la page ──
    // Chaque lancement de lecture laisse une trace permanente (create-only,
    // champs bornés). La présence en direct est un battement par session que
    // le visiteur écrase toutes les 30 s; seul l'admin lit les deux.
    match /podcastListens/{id} {
      allow create: if request.resource.data.keys().hasOnly(['episodeId', 'episodeTitle', 'startedAt', 'sessionId'])
                    && request.resource.data.episodeId is string
                    && request.resource.data.episodeId.size() < 300
                    && request.resource.data.episodeTitle is string
                    && request.resource.data.episodeTitle.size() < 300
                    && request.resource.data.sessionId is string
                    && request.resource.data.sessionId.size() < 80;
      allow read, update, delete: if isAdmin();
    }
    match /podcastPresence/{sessionId} {
      allow write: if request.resource.data.keys().hasOnly(['episodeId', 'episodeTitle', 'lastSeen'])
                   && request.resource.data.episodeId is string
                   && request.resource.data.episodeId.size() < 300
                   && request.resource.data.episodeTitle is string
                   && request.resource.data.episodeTitle.size() < 300;
      allow delete: if true;
      allow read: if isAdmin();
    }

    // ── Newsletter subscribers ──
    // Public form submits a new signup (email-only). Admins manage the CRM.
    // Unauthenticated clients may NOT read the subscriber list. Unsubscribe
    // goes through the `unsubscribeByToken` Cloud Function (Admin SDK) so we
    // don't need any public read access to this collection.
    match /newsletter/{id} {
      allow create: if request.resource.data.keys().hasAll(['email'])
                    && request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }

    // ── Newsletter campaigns ──
    // Only admins can create, update, delete. Bodies are readable by anyone
    // because recipients (including non-admin members) open archived emails
    // in their client portal, and the fetch needs read access to the doc.
    // Sensitive info (subscriber addresses) is NOT in this doc.
    match /newsletters/{id} {
      allow read: if resource.data.status == 'sent' || isAdmin();
      allow write: if isAdmin();
    }
    match /bookingRequests/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email']);
      allow read, update, delete: if isAdmin();
    }

    // ── Vexel inquiries (Salon des Inconnus contact card → /vexel inbox) ──
    // Public form creates a lead; only admins may list, read, or delete them.
    match /vexelInquiries/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string;
      allow read, update, delete: if isAdmin();
    }

    // ── Dosha quiz: public create. Members read their own. Admins full. ──
    match /doshaResults/{id} {
      allow create: if request.resource.data.keys().hasAll(['email', 'dominant']);
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ── "Laissez-vous guider" responses: public create (may be anonymous).
    //    Signed-in members read their own; admins read all. ───────────────
    match /guideResponses/{id} {
      allow create: if true;
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ── Member profiles: user owns their own profile. Admins full. ──
    match /members/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid);
      allow update: if isSelf(uid) || isAdmin();
      allow delete: if isAdmin();

      // Newsletter inbox pointers — written by the send Cloud Function (which
      // uses the Admin SDK and bypasses rules). The member can read their own
      // inbox and mark messages as read; they cannot create new entries.
      match /inbox/{newsletterId} {
        allow read: if isSelf(uid) || isAdmin();
        allow update: if isSelf(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
        allow create, delete: if isAdmin();
      }
    }

    // ── Client orders: member reads own, admin full. Created at checkout. ──
    match /clientOrders/{id} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── Shopify orders (written by Cloud Functions via Admin SDK, which bypasses rules).
    // Readable by admin in the dashboard. No client writes.
    match /shopifyOrders/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Loyalty points ──
    // `memberPoints/{uid}` — one doc per member; client-side transactions in
    // `src/firebase/points.ts` both increment (award) and decrement (redeem)
    // via the owner's auth. Server-side validation (caps, delta checks) will
    // live in Cloud Functions once we upgrade; for now the audit trail in
    // pointsEvents lets Krystine spot anything fishy from the admin panel.
    match /memberPoints/{uid} {
      allow read, write: if isSelf(uid) || isAdmin();
    }

    // `pointsEvents/{dedupKey}` — append-only log. Owner creates their own
    // events; owner + admin can read. Updates / deletes locked to admin so a
    // user can't rewrite history.
    match /pointsEvents/{id} {
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // `rewardRedemptions/{id}` — client creates a pending redemption; admin
    // fulfills / cancels.
    match /rewardRedemptions/{id} {
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ── Support messaging ──
    // Conversation doc keyed by member uid; only the owner and admins can read/write.
    match /conversations/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isSelf(uid) || isAdmin();

      match /messages/{mid} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if (isSelf(uid) && request.resource.data.sender == 'client')
                      || (isAdmin() && request.resource.data.sender == 'admin');
        allow update, delete: if isAdmin();
      }
    }
  }
}
